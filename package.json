{
  "name": "w2-generator-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.mlftechnologiesllc.w2generator",
    "productName": "W2 Generator Tool",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "forceCodeSigning": false
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}
